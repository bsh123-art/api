# ---------------------------------------------------------------------------
# Copy to `.env` and replace every CHANGE_ME value before running.
# NEVER commit the real `.env` file.
# ---------------------------------------------------------------------------

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_USER=kopi
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=kopi_pos
POSTGRES_PORT=5432

# Used by the API / Prisma. Inside docker-compose the host is `postgres`.
# Supabase: use the Transaction pooler URL for the API runtime.
# Copy it from Supabase Dashboard > Connect > Transaction pooler.
# Keep the password URL-encoded and append `?sslmode=require&schema=public`.
# DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres?sslmode=require&schema=public

# --- API --------------------------------------------------------------------
NODE_ENV=development
API_PORT=4000
API_URL=http://localhost:4000

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=CHANGE_ME_access_secret_min_32_chars_long_random
JWT_REFRESH_SECRET=CHANGE_ME_refresh_secret_min_32_chars_long_random
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Comma separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000

# Cookie hardening — set to `true` when serving over HTTPS
COOKIE_SECURE=false
COOKIE_DOMAIN=

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

# Bootstrap admin created by `npm run db:seed`
SEED_ADMIN_EMAIL=admin@kopipos.local
SEED_ADMIN_PASSWORD=CHANGE_ME_admin_password
SEED_CASHIER_EMAIL=cashier@kopipos.local
SEED_CASHIER_PASSWORD=CHANGE_ME_cashier_password

# Filesystem location for generated database backups
BACKUP_DIR=./storage/backups

# --- Web --------------------------------------------------------------------
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_NAME=Kopi POS
NEXT_PUBLIC_CURRENCY=IDR
NEXT_PUBLIC_LOCALE=id-ID
